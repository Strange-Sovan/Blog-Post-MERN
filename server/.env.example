NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/blog_mern
JWT_ACCESS_SECRET=replace_with_a_unique_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_unique_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
CLIENT_URL=http://localhost:5173

# Admin Seeder Credentials
ADMIN_EMAIL=admin@blogmern.com
ADMIN_PASSWORD=Admin123!


